PORT=8792
HOST=127.0.0.1
NODE_ENV=production

# Comma-separated browser origins allowed to call this API
ALLOWED_ORIGINS=https://bonotech.io,https://www.bonotech.io,https://bonotech-website.web.app,https://bonotech-website.firebaseapp.com,http://localhost:5174,http://localhost:5173

# Only these addresses may appear in the request recipient list
ALLOWED_RECIPIENTS=ekram@edutechs.app,humaira@di.vc,contact@bonotech.io

# Gmail (App Password) — or set SMTP_* below instead
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=Bonotech Website

# Optional generic SMTP (used when GMAIL_USER is empty)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@bonotech.io

# Admin portal (JWT). Generate hash: node -e "import('bcryptjs').then(async b=>console.log(await b.hash('YOUR_PASSWORD',12)))"
ADMIN_EMAIL=ekram@edutechs.app
ADMIN_PASSWORD_HASH=
ADMIN_JWT_SECRET=
# Extra admins: comma-separated email=bcryptHash pairs
ADMIN_USERS=

# ZoomInfo WebSights (script key already in index.html). Optional API credentials
# unlock company enrichment into the admin portal via POST /enrich/ip.
ZOOMINFO_WEBSIGHTS_KEY=24d3db47bc1789020543
# ZOOMINFO_USERNAME=
# ZOOMINFO_PASSWORD=
